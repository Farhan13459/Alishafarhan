{
     "name": "ai-shopping-assistant",
     "version": "1.0.0",
     "description": "AI-powered shopping assistant with natural language processing, image search, and multi-language support",
     "main": "index.js",
     "scripts": {
          "start": "node index.js",
          "dev": "nodemon index.js",
          "prod": "NODE_ENV=production node index.js",
          "test": "jest",
          "lint": "eslint .",
          "lint:fix": "eslint . --fix",
          "format": "prettier --write .",
          "setup": "node create-admin.js",
          "seed": "node scripts/seed-products.js"
     },
     "keywords": [
          "ai",
          "shopping",
          "chatbot",
          "nlp",
          "ecommerce",
          "multilingual",
          "image-search",
          "voice-search",
          "daraz-scraper"
     ],
     "author": {
          "name": "Your Name",
          "email": "your.email@example.com",
          "url": "https://github.com/yourusername"
     },
     "license": "MIT",
     "repository": {
          "type": "git",
          "url": "https://github.com/yourusername/ai-shopping-assistant"
     },
     "bugs": {
          "url": "https://github.com/yourusername/ai-shopping-assistant/issues"
     },
     "homepage": "https://github.com/yourusername/ai-shopping-assistant#readme",
     "engines": {
          "node": ">=18.0.0",
          "npm": ">=8.0.0"
     },
     "dependencies": {
          "axios": "^1.6.0",
          "bcryptjs": "^2.4.3",
          "cheerio": "^1.0.0-rc.12",
          "compression": "^1.7.4",
          "cors": "^2.8.5",
          "dotenv": "^16.3.1",
          "express": "^4.21.2",
          "express-rate-limit": "^7.1.5",
          "helmet": "^7.1.0",
          "jsonwebtoken": "^9.0.2",
          "morgan": "^1.10.0",
          "multer": "^1.4.5-lts.1",
          "uuid": "^9.0.1"
     },
     "devDependencies": {
          "eslint": "^8.52.0",
          "eslint-config-prettier": "^9.0.0",
          "eslint-plugin-prettier": "^5.0.1",
          "jest": "^29.7.0",
          "nodemon": "^3.0.1",
          "prettier": "^3.1.0",
          "supertest": "^6.3.3"
     },
     "jest": {
          "testEnvironment": "node",
          "collectCoverageFrom": [
               "**/*.js",
               "!**/node_modules/**",
               "!**/coverage/**"
          ],
          "coverageThreshold": {
               "global": {
                    "branches": 70,
                    "functions": 70,
                    "lines": 70,
                    "statements": 70
               }
          }
     },
     "prettier": {
          "semi": true,
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "printWidth": 100,
          "bracketSpacing": true,
          "arrowParens": "avoid"
     }
}
